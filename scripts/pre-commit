#!/usr/bin/env sh
# Pre-commit: autofix → lint → test + coverage ≥ 70%
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)
MIN_COVERAGE="${MIN_COVERAGE:-70}"

echo "==> Autofix: goimports-reviser"
if ! command -v goimports-reviser >/dev/null 2>&1; then
	echo "goimports-reviser not found. Run: make tools" >&2
	exit 1
fi
goimports-reviser -format -recursive .

echo "==> Autofix: golangci-lint"
if ! command -v golangci-lint >/dev/null 2>&1; then
	echo "golangci-lint not found. Run: make tools" >&2
	exit 1
fi
# v2 formatter (no-op / harmless if unsupported)
golangci-lint fmt ./... 2>/dev/null || true
# Apply safe autofixes, then fail on anything still wrong
golangci-lint run --fix ./... || true

echo "==> Lint"
golangci-lint run ./...

echo "==> Test + coverage (min ${MIN_COVERAGE}%)"
# Full module — same scope as CI / make coverage.
go test ./... \
	-coverprofile=coverage.out -covermode=atomic -count=1
TOTAL=$(go tool cover -func=coverage.out | awk '/^total:/{print $3}' | tr -d '%')
echo "Total coverage: ${TOTAL}%"
awk -v t="$TOTAL" -v min="$MIN_COVERAGE" 'BEGIN {
	if ((t+0) < (min+0)) {
		printf "Coverage %.1f%% is below the %s%% minimum\n", t+0, min
		exit 1
	}
	printf "Coverage %.1f%% meets the %s%% minimum\n", t+0, min
}'

# Re-stage files that were already staged (autofix may have rewritten them)
if [ -n "$STAGED_FILES" ]; then
	echo "$STAGED_FILES" | while IFS= read -r f; do
		if [ -n "$f" ] && [ -e "$f" ]; then
			git add -- "$f"
		fi
	done
fi

echo "Pre-commit checks passed."
